# Mühlenbergschule Osloß – Apache-Konfiguration für OVH-Webspace
# (statische Astro-Seite, trailingSlash: always)
# Ein Ordner für Live (www.) UND Vorschau (vorschau.) – Unterschied nur per Hostname.

Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType video/mp4 .mp4
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ohne www → www (nur Hauptdomain; vorschau.* bleibt erreichbar)
  RewriteCond %{HTTP_HOST} ^muehlenbergschule-osloss\.de$ [NC]
  RewriteRule ^ https://www.muehlenbergschule-osloss.de%{REQUEST_URI} [L,R=301]
  # HTTPS erzwingen (OVH-Empfehlung: Port-Abfrage statt %{HTTPS})
  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Vorschau-Subdomain: für Suchmaschinen gesperrt
  RewriteCond %{HTTP_HOST} ^vorschau\. [NC]
  RewriteRule ^robots\.txt$ /robots-vorschau.txt [L]

  # Alte WordPress-Uploads (PDFs) → /dokumente/
  RewriteRule ^wp-content/uploads/\d{4}/\d{2}/(.+\.pdf)$ https://%{HTTP_HOST}/dokumente/$1 [L,R=301,NC]
  # Alte WordPress-Systempfade
  RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|feed)(/.*)?$ https://%{HTTP_HOST}/ [L,R=301]
  RewriteRule ^(author|category)/ https://%{HTTP_HOST}/news/ [L,R=301]
</IfModule>

# Umgezogene / entfernte WordPress-Seiten
# (RewriteRule mit absolutem Ziel – RedirectMatch hängt bei OVH sonst „:443“ an)
RewriteEngine On
RewriteRule ^newsarchiv/page/(\d+)/?$ https://%{HTTP_HOST}/news/$1/ [R=301,L]
RewriteRule ^newsarchiv/?$ https://%{HTTP_HOST}/news/ [R=301,L]
RewriteRule ^iserv/?$ https://gsosloss.de/iserv/app/login [R=301,L]
RewriteRule ^eltern/infektionsschutz/?$ https://%{HTTP_HOST}/formulare/ [R=301,L]
RewriteRule ^eltern/schulferien-feiertage/?$ https://%{HTTP_HOST}/schulleben/termine/ [R=301,L]
RewriteRule ^leitbild/kooperationen/?$ https://%{HTTP_HOST}/leitbild/ [R=301,L]
RewriteRule ^schulleben/?$ https://%{HTTP_HOST}/news/ [R=301,L]
RewriteRule ^startseite/?$ https://%{HTTP_HOST}/ [R=301,L]

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} =~ /^vorschau\./"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Astro-Assets haben Hash im Namen → 1 Jahr cachen
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(pdf|mp4|png|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

